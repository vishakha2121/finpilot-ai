git add .
git commit -m "first commit with gitignore"
git push -u origin maingit add .
git commit -m "first commit with gitignore"
git push -u origin maingit add .
git commit -m "first commit with gitignore"
git push -u origin main

# ============================================================
#  FinPilot AI — .gitignore
#  Covers: Python, Node, React, ML, IDE, OS, Secrets
# ============================================================

# ------------------------------------------------------------
#  🔐 ENVIRONMENT & SECRETS (MOST IMPORTANT)
# ------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.test
*.env
!.env.example
secrets.json
credentials.json
*.pem
*.key
api_keys.txt


# ------------------------------------------------------------
#  🐍 PYTHON / BACKEND
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.venv*/
virtualenv/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log
cover/

# Jupyter Notebook
.ipynb_checkpoints
profile_default/
ipython_config.py

# PEP 582
__pypackages__/

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mkdocs
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# pytype
.pytype/

# Cython
cython_debug/


# ------------------------------------------------------------
#  🗄️ DATABASE (SQLite / DB Files)
# ------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
finpilot.db
data/*.db
backend/*.db


# ------------------------------------------------------------
#  🤖 ML MODELS & DATA (Large Files)
# ------------------------------------------------------------
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors

# Keep folder structure but not the models
data/models_saved/*
!data/models_saved/.gitkeep

data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

*.csv
!data/raw/sample_transactions.csv

*.parquet
*.feather


# ------------------------------------------------------------
#  📦 NODE / REACT / FRONTEND
# ------------------------------------------------------------
node_modules/
node_modules
/.pnp
.pnp.js
.pnp.cjs

# Production build
/build
/dist
/.next/
/out/

# Testing
/coverage
*.lcov

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Misc
.DS_Store
*.pem
.npm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn-integrity

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

